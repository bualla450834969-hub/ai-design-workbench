# 授权码配置（逗号分隔多个 LIHUO 授权码，每个最多绑定3个设备）
LICENSE_CODES=LIHUO88888888,ANOTHER-CODE-0001

# 本地平板测试码。默认关闭。设为 1 后可用 LOCAL-TABLET 进入，不连接远程授权服务器。
# TABLET_ALLOW_TEST_CODE=1
# TABLET_LOCAL_TEST_CODE=LOCAL-TABLET

# 额外的完整 IDAI1 授权码（逗号或换行分隔）。不要在这里写生成规则。
# IDAI1_LICENSE_CODES=

# 兼容旧版（二选一即可）
# APP_ACCESS_CODE=LIHUO88888888

# Upstash Redis（可选，用于生产环境设备绑定持久化）
# 不配置则使用内存存储（服务器重启后绑定关系丢失）
# UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
