# 访问授权码（必填，用于保护本地服务）
APP_ACCESS_CODE=

# AI 供应商 API Key（按需填写，不会上传到任何地方）
# GeekAI
GEEKNOW_API_KEY=
# API易
APIYI_API_KEY=
# AIHubMix
AIHUBMIX_API_KEY=
# 自定义 OpenAI 兼容
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=

# 服务端托管模式（可选，设为 true 时使用服务端配置的 Key）
SERVER_MANAGED_API_ENABLED=false
SERVER_MANAGED_API_PROVIDER=geeknow
